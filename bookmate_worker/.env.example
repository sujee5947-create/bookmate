# ===== BOOKMATE AI 처리 서버 설정 =====
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채워 주세요. .env 는 절대 공유하거나 GitHub에 올리지 마세요.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) : 모든 권한을 가진 열쇠예요. 이 파일에만 넣으세요.
SUPABASE_SECRET_KEY=

# --- Claude (요약 · 추천 · 토론) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Cloud 음성 인식 (STT) ---
GCP_PROJECT=
GCS_BUCKET=
GCP_REGION=asia-northeast1
GOOGLE_APPLICATION_CREDENTIALS=google-key.json

# --- 사용량 제한 (비용 보호) ---
# 음성 인식: 모임 전체가 한 달에 쓸 수 있는 분 수
STT_MONTHLY_MIN_LIMIT=100
# AI 토론: 한 사람이 하루에 보낼 수 있는 메시지 수
CHAT_DAILY_LIMIT=10
# 다음 책 추천: 한 사람이 하루에 받을 수 있는 횟수
REC_DAILY_LIMIT=5
# 음성 인식 방식: batch = 절약 모드(가격 약 80% 저렴, 결과가 몇 분~최대 24시간 걸려요) / fast = 일반(빠르지만 비쌈)
STT_MODE=batch
# 동시에 처리할 녹음 수
PARALLEL_RECORDINGS=2

# --- 기타 ---
# 원본 녹음 오디오를 N일 뒤 자동 삭제 (0이면 삭제 안 함). 대화 기록과 요약은 계속 남아요.
RETENTION_DAYS=30
POLL_SECONDS=5
SEGMENT_SECONDS=3000
